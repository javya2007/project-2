# ============================================================
# ReelSense AI - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ── App Meta ─────────────────────────────────────────────────
VITE_APP_NAME="ReelSense AI"
VITE_APP_TAGLINE="Turn Your Scroll Into Your Skill"
VITE_APP_VERSION="1.0.0"

# ── YouTube Data API v3 ──────────────────────────────────────
# Get yours at https://console.cloud.google.com/apis/credentials
VITE_YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
VITE_YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3

# ── Instagram Graph API ──────────────────────────────────────
# Requires Facebook Developer App: https://developers.facebook.com/
VITE_INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN_HERE
VITE_INSTAGRAM_API_BASE=https://graph.instagram.com/v18.0

# ── OpenAI / LLM Embedding API ──────────────────────────────
# For semantic interest vector embedding (future upgrade)
VITE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
VITE_OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Feature Flags ───────────────────────────────────────────
# Set to "true" to enable, "false" to disable
VITE_ENABLE_LIVE_YOUTUBE_FEED=false
VITE_ENABLE_LIVE_INSTAGRAM_FEED=false
VITE_ENABLE_LLM_RECOMMENDATIONS=false
VITE_ENABLE_ANALYTICS_EXPORT=false

# ── Recommendation Engine ───────────────────────────────────
VITE_MAX_FEED_REELS=50
VITE_PROCEDURAL_BATCH_SIZE=10
VITE_MIN_EDU_SCORE_THRESHOLD=60

# ── LocalStorage Keys ───────────────────────────────────────
VITE_STORAGE_INTERACTIONS_KEY=reelsense_interactions_v1
VITE_STORAGE_SAVED_KEY=reelsense_saved_reels_v1
VITE_STORAGE_PREFS_KEY=reelsense_user_prefs_v1

# ── Debug ────────────────────────────────────────────────────
VITE_DEBUG_MODE=false
VITE_LOG_INTERACTIONS=false
